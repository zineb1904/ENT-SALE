# Copier ce fichier en ".env" (cp .env.example .env) puis adapter les valeurs.
# Ne JAMAIS mettre le fichier .env sur GitHub.

# JWT : remplacer par une longue valeur aléatoire
JWT_SECRET=changez-moi-avec-une-longue-valeur-aleatoire
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Keycloak (realm et client créés par BACKEND/keycloak/ent-sale-realm.json)
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=ent-sale
KEYCLOAK_CLIENT_ID=ent-client
# Doit être identique au "secret" du client dans ent-sale-realm.json
KEYCLOAK_CLIENT_SECRET=ent-client-demo-secret

APP_ENV=development
