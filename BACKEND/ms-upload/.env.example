# Copier ce fichier en ".env" (cp .env.example .env) puis adapter les valeurs.
# Ne JAMAIS mettre le fichier .env sur GitHub.

# ms-auth
MS_AUTH_URL=http://ms-auth:8001

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=ent_upload

# MinIO
MINIO_URL=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cours

# Cassandra
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=ent_upload

APP_ENV=development
